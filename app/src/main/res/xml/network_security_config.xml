<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- OWASP M3: Enforce HTTPS & Disallow cleartext across all connections -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Production API Pinning & Modern TLS Policy -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.guardiantrack.io</domain>
        <!-- Trust only system CAs; reject user-installed CAs to mitigate MITM proxies -->
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
        <!-- Public-Key-Pins: Primary + Backup Pin for TLS Certificate Rotation -->
        <pin-set expiration="2026-12-31">
            <!-- Primary Pin (SHA-256 of SubjectPublicKeyInfo for api.guardiantrack.io) -->
            <pin digest="SHA-256">47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU=</pin>
            <!-- Backup Pin (Standby Root/Intermediate for zero-downtime rotation) -->
            <pin digest="SHA-256">++MBgDH5WGvL9Bcn5Be30cRcL0f5O+NyoXuWtQdX1aI=</pin>
        </pin-set>
    </domain-config>
</network-security-config>
